---
import Github from "./icons/Github.astro";
import React from "./icons/React.astro";
import Tailwind from "./icons/Tailwind.astro";
import LinkIcon from "./icons/LinkIcon.astro";
import ProjectButton from "./ProjectButton.astro";
import Node from "./icons/Node.astro";
import NextJs from "./icons/NextJs.astro";
import Supabase from "./icons/Supabase.astro";

const TAGS = {
  REACT: {
    name: "React",
    class: "bg-[#24272e] text-[#75c2d9]",
    icon: React,
  },
  TAILWINDCSS: {
    name: "Tailwind CSS",
    class: "bg-[#0c649b] text-white",
    icon: Tailwind,
  },
  NODEJS: {
    // TODO Fix this
    name: "Node.js",
    class: "bg-[#3c873a] text-white",
    icon: Node,
  },
  NEXTJS: {
    name: "Next.js",
    class: "bg-[#000000] text-white",
    icon: NextJs,
  },
  SUPABASE: {
    name: "Supabase",
    class: "bg-[#000000] text-white",
    icon: Supabase,
  },
};

const PROJECTS = [
  {
    title: "Proyectos",
    description:
      "Página con proyectos realizados en React. Casi como un playground personal.",
    link: "https://kurtex.github.io/projects/",
    github: "https://github.com/kurtex/projects",
    image: "/assets/projects/proyectos.webp",
    tags: [TAGS.REACT, TAGS.TAILWINDCSS],
  },
  {
    title: "Shorten URL",
    description: "Recortador de URLs con autenticación de usuarios.",
    link: "https://shorten-app-ten.vercel.app/",
    github: "https://github.com/kurtex/shortenApp",
    image: "/assets/projects/shorten.webp",
    tags: [
      TAGS.REACT,
      TAGS.TAILWINDCSS,
      TAGS.NODEJS,
      TAGS.NEXTJS,
      TAGS.SUPABASE,
    ],
  },
];
---

{
  PROJECTS.map(({ title, description, tags, image, github, link }) => (
    <article class="flex flex-row gap-x-5 ">
      <img
        src={image}
        alt={title}
        class="rounded shadow-2xl shadow-white/10 w-full h-56 hover:scale-105 transition"
      />
      <div class="w-full">
        <h3 class="text-2xl font-semibold text-yellow-600 dark:text-yellow-200 mb-2">
          {title}
        </h3>
        <ul class="flex gap-2 flex-row mb-4 flex-wrap w-[300px] ">
          {tags.map((tag) => (
            <li>
              <span
                class={`flex gap-x-1 rounded-full text-[11px] ${tag.class} py-0.5 px-1.5`}>
                <tag.icon class="size-4" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>
        <p class="text-base mb-5 text-pretty">{description}</p>
        <nav class="flex w-full gap-x-3">
          <ProjectButton link={github}>
            <Github /> Github
          </ProjectButton>
          <ProjectButton link={link}>
            <LinkIcon /> Website
          </ProjectButton>
        </nav>
      </div>
    </article>
  ))
}
